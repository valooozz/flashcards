{
  "expo": {
    "scheme": "acme",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-localization"
    ],
    "name": "Flipo",
    "slug": "flipo",
    "version": "1.6.0",
    "android": {
      "package": "com.valooozz.flipo",
      "windowSoftInputMode": "adjustPan"
    },
    "icon": "./assets/images/logo.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "975269d3-2cde-4eee-b24c-92caec2d98ed"
      }
    }
  }
}